<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>MakeFileProj</Keyword>
    <ProjectGuid>{48d68dba-8355-4c29-9852-cf0e794a0c8f}</ProjectGuid>
    <RootNamespace>gameframework</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <GameFrameworkPreset Condition="'$(VisualStudioVersion)'=='17.0'">windows-vs2022</GameFrameworkPreset>
    <GameFrameworkPreset Condition="'$(GameFrameworkPreset)'==''">windows-vs2026</GameFrameworkPreset>
    <GameFrameworkBuildDir>$(ProjectDir)out\build\$(GameFrameworkPreset)</GameFrameworkBuildDir>
    <GameFrameworkCMake Condition="Exists('$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</GameFrameworkCMake>
    <GameFrameworkCMake Condition="'$(GameFrameworkCMake)'==''">cmake.exe</GameFrameworkCMake>
    <NMakeBuildCommandLine>"$(GameFrameworkCMake)" --preset $(GameFrameworkPreset) -S "$(ProjectDir)." &amp;&amp; "$(GameFrameworkCMake)" --build "$(GameFrameworkBuildDir)" --config $(Configuration)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>"$(GameFrameworkCMake)" --preset $(GameFrameworkPreset) -S "$(ProjectDir)." &amp;&amp; "$(GameFrameworkCMake)" --build "$(GameFrameworkBuildDir)" --config $(Configuration) --clean-first</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist "$(GameFrameworkBuildDir)\CMakeCache.txt" "$(GameFrameworkCMake)" --build "$(GameFrameworkBuildDir)" --config $(Configuration) --target clean</NMakeCleanCommandLine>
    <NMakeOutput>$(GameFrameworkBuildDir)\$(Configuration)\Sandbox.exe</NMakeOutput>
    <NMakeIncludeSearchPath>$(ProjectDir)engine;$(ProjectDir)ThirdParty\glad\include;$(GameFrameworkBuildDir)\_deps\glfw-src\include;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <NMakePreprocessorDefinitions>GLFW_INCLUDE_NONE;WIN32_LEAN_AND_MEAN;NOMINMAX;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <LocalDebuggerCommand>$(NMakeOutput)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(GameFrameworkBuildDir)\$(Configuration)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="game_framework.cpp" />
    <ClCompile Include="engine\Application.cpp" />
    <ClCompile Include="engine\Logger.cpp" />
    <ClCompile Include="engine\Physics.cpp" />
    <ClCompile Include="engine\Renderer.cpp" />
    <ClCompile Include="demo\Combat.cpp" />
    <ClCompile Include="demo\Demo.cpp" />
    <ClCompile Include="demo\Platform.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="engine\Application.hpp" />
    <ClInclude Include="engine\Input.hpp" />
    <ClInclude Include="engine\Logger.hpp" />
    <ClInclude Include="engine\Math.hpp" />
    <ClInclude Include="engine\Physics.hpp" />
    <ClInclude Include="engine\Renderer.hpp" />
    <ClInclude Include="engine\World.hpp" />
    <ClInclude Include="demo\Demo.hpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="engine\AabbMasks.asm" />
    <None Include="CMakeLists.txt" />
    <None Include="CMakePresets.json" />
    <None Include="README.md" />
    <None Include="Docs\Architecture.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
